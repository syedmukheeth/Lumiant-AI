# Copy to .env for local overrides. Never put real credentials in this file or in git.

# development | test | production
LUMIANT_APP_ENV=development
# dev | oidc   (dev is refused at startup when APP_ENV=production; oidc arrives in M6)
LUMIANT_AUTH_MODE=dev
# Optional in development: if unset, a random secret is generated per process (sessions reset on restart).
# LUMIANT_DEV_JWT_SECRET=
LUMIANT_SESSION_TTL_MINUTES=480
# Set to true when served over HTTPS (required in production).
LUMIANT_COOKIE_SECURE=false
LUMIANT_LOG_LEVEL=INFO
# SQLite in development; PostgreSQL in production (e.g. postgresql+psycopg://…, supplied via secret manager).
# LUMIANT_APP_DB_URL=sqlite:///var/app.db
# Client extracts (ADR-0008) — development only, never in production. Generated by `lumiant-ingest sap`.
# LUMIANT_PRIVATE_TENANTS_DIR=var/private/tenants
# LUMIANT_ALLOW_CUSTOMER_EXTRACTS=false
# AI provider for the assistant (ADR-0009): rules (built-in, offline) | anthropic | gemini.
# External AI is only used for tenants whose YAML sets ai.external_provider_approved: true.
# LUMIANT_AGENT_PROVIDER=gemini
# LUMIANT_GEMINI_API_KEY=            # from Google AI Studio; keep it only in .env (git-ignored). Use a paid key
#                                    # before any client data can reach it: free-tier prompts may be used by Google.
# LUMIANT_GEMINI_MODEL=gemini-flash-latest
